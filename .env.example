# Documentation template only. Node does not auto-load .env files.
# Set variables in the launching PowerShell session, or use the Windows launcher.
# Real local workspace defaults:
PORT=8000
# AQUAOPS_DATA_DIR=C:\Users\YOUR_USER\Documents\AquaOps\data
# Optional Windows launcher runtime override (Node 24.14+ in 24.x):
# AQUAOPS_NODE=C:\Program Files\nodejs\node.exe
# Browser testing only, when Playwright is not locally resolvable:
# AQUAOPS_PLAYWRIGHT=C:\absolute\path\to\node_modules\playwright
# AQUAOPS_BROWSER_CHANNEL=msedge
# Demo uses Start-AquaOpsDemo.cmd with its isolated data directory and port 8001.
# No API key, email service or external AI provider is required or configured.
